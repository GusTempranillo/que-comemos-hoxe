# Copia este ficheiro a .env e cubre os valores reais.
# .env NUNCA debe subirse a git (xa está en .gitignore desta carpeta).

# Porto onde escoita este servidor (Nginx faralle de proxy inverso por riba).
PORT=3001

# Segredo compartido que debe mandar o frontend en "Authorization: Bearer <isto>".
# Pode ser calquera cadea longa e aleatoria — non ten que ser o mesmo código
# de acceso que usa n8n, aínda que pode selo se queres reutilizalo.
IA_ACCESS_TOKEN=cambia-isto-por-algo-longo-e-aleatorio

# Orixes desde as que se aceptan peticións (separadas por comas se hai varias,
# ex. para probar en local ademais de en produción).
ORIXES_PERMITIDAS=https://qch.pages.dev

# --- Provedor de IA ---
# Por defecto apunta a Moonshot (Kimi), que xa se usaba dende n8n, pero
# calquera API compatible con OpenAI (chat completions) vale: só hai que
# cambiar AI_BASE_URL, AI_API_KEY e AI_MODEL.
AI_BASE_URL=https://api.moonshot.cn/v1
AI_API_KEY=a-tua-clave-real-aqui
AI_MODEL=moonshot-v1-8k
